embed-server --server-config=standalone-full.xml --std-out=discard
/subsystem=messaging-activemq/server=default/address-setting=jms.queue.HandlingEventRegistrationAttemptQueue:write-attribute(name=dead-letter-address,value="jms.queue.RejectedRegistrationAttemptsQueue")
/subsystem=messaging-activemq/server=default/address-setting=jms.queue.RejectedRegistrationAttemptsQueue:add(dead-letter-address="jms.queue.DLQ",max-delivery-attempts=3)
/subsystem=messaging-activemq/server=default/address-setting=jms.queue.HandlingEventRegistrationAttemptQueue:write-attribute(name=max-delivery-attempts,value=3)
/subsystem=messaging-activemq/server=default/address-setting=jms.queue.HandlingEventRegistrationAttemptQueue:write-attribute(name=redelivery-delay,value=250)
/subsystem=messaging-activemq/server=default/security-setting="#":remove
/subsystem=messaging-activemq/server=default/security-setting="#":add
/subsystem=messaging-activemq/server=default/security-setting=jms.queue.HandlingEventRegistrationAttemptQueue:add
/subsystem=messaging-activemq/server=default/security-setting=jms.queue.HandlingEventRegistrationAttemptQueue/role=HandlingAttemptProducer:add(send=true)
/subsystem=messaging-activemq/server=default/security-setting=jms.queue.HandlingEventRegistrationAttemptQueue/role=HandlingWorker:add(consume=true)
/subsystem=messaging-activemq/server=default/security-setting=jms.queue.CargoHandledQueue:add
/subsystem=messaging-activemq/server=default/security-setting=jms.queue.CargoHandledQueue/role=HandlingWorker:add(send=true)
/subsystem=messaging-activemq/server=default/security-setting=jms.queue.CargoHandledQueue/role=InspectionWorker:add(consume=true)
/subsystem=messaging-activemq/server=default/security-setting=jms.queue.MisdirectedCargoQueue:add
/subsystem=messaging-activemq/server=default/security-setting=jms.queue.MisdirectedCargoQueue/role=InspectionWorker:add(send=true)
/subsystem=messaging-activemq/server=default/security-setting=jms.queue.MisdirectedCargoQueue/role=NotificationWorker:add(consume=true)
/subsystem=messaging-activemq/server=default/security-setting=jms.queue.DeliveredCargoQueue:add
/subsystem=messaging-activemq/server=default/security-setting=jms.queue.DeliveredCargoQueue/role=InspectionWorker:add(send=true)
/subsystem=messaging-activemq/server=default/security-setting=jms.queue.DeliveredCargoQueue/role=NotificationWorker:add(consume=true)
/subsystem=messaging-activemq/server=default/security-setting=jms.queue.RejectedRegistrationAttemptsQueue:add
/subsystem=messaging-activemq/server=default/security-setting=jms.queue.RejectedRegistrationAttemptsQueue/role=NotificationWorker:add(consume=true)
stop-embedded-server
