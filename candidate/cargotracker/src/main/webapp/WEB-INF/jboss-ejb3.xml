<?xml version="1.0" encoding="UTF-8"?>
<jboss:jboss xmlns="http://java.sun.com/xml/ns/javaee"
    xmlns:jboss="http://www.jboss.com/xml/ns/javaee"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:s="urn:security:1.1"
    xsi:schemaLocation="http://www.jboss.com/xml/ns/javaee http://www.jboss.org/j2ee/ejb-jar_3_1.xsd http://www.jboss.com/xml/ns/javaee http://www.jboss.org/j2ee/schema/jboss-ejb3-2_0.xsd"
    version="3.1" impl-version="2.0">
  <assembly-descriptor>
    <s:security>
      <ejb-name>BatchImportRequestService</ejb-name>
      <s:security-domain>other</s:security-domain>
      <s:run-as-principal>batch-trigger</s:run-as-principal>
    </s:security>
    <s:security>
      <ejb-name>BatchImportLauncher</ejb-name>
      <s:security-domain>other</s:security-domain>
      <s:run-as-principal>batch-worker</s:run-as-principal>
    </s:security>
    <s:security>
      <ejb-name>HandlingEventRegistrationAttemptConsumer</ejb-name>
      <s:security-domain>other</s:security-domain>
      <s:run-as-principal>handling-worker</s:run-as-principal>
    </s:security>
    <s:security>
      <ejb-name>CargoHandledConsumer</ejb-name>
      <s:security-domain>other</s:security-domain>
      <s:run-as-principal>inspection-worker</s:run-as-principal>
    </s:security>
    <s:security>
      <ejb-name>DeliveredCargoConsumer</ejb-name>
      <s:security-domain>other</s:security-domain>
      <s:run-as-principal>notification-worker</s:run-as-principal>
    </s:security>
    <s:security>
      <ejb-name>MisdirectedCargoConsumer</ejb-name>
      <s:security-domain>other</s:security-domain>
      <s:run-as-principal>notification-worker</s:run-as-principal>
    </s:security>
    <s:security>
      <ejb-name>RejectedRegistrationAttemptsConsumer</ejb-name>
      <s:security-domain>other</s:security-domain>
      <s:run-as-principal>notification-worker</s:run-as-principal>
    </s:security>
  </assembly-descriptor>
</jboss:jboss>
